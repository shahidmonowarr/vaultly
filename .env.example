# Local development targets the docker-compose services below.
DATABASE_URL=postgres://sfs:sfs@localhost:5433/sfs

# openssl rand -hex 32
AUTH_SECRET=

# MinIO locally. In production drop S3_ENDPOINT for AWS S3, or point it at
# the Cloudflare R2 / Backblaze B2 endpoint for the account.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sfs-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE_BYTES=536870912
USER_QUOTA_BYTES=2147483648
